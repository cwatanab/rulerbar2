{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.6.13",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "cwatanab",
  "icons": {
    "32": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{c8b9d3e2-4a1f-4b5c-9d2a-8f7e6a1b2c3d}",
      "strict_min_version": "128.0",
      "strict_max_version": "152.*"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "experiment_apis": {
    "rulerBar": {
      "schema": "api/rulerbar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["rulerBar"]],
        "script": "api/rulerbar/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
